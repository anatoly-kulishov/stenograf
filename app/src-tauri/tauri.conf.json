{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stenograf",
  "version": "0.1.0",
  "identifier": "app.stenograf.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stenograf",
        "width": 880,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/stenograf-core"],
    "resources": {
      "../../core/dist/stenograf-core/": "sidecar/"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
